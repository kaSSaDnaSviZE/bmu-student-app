# Copy to the staging secret store. Do not commit the filled file.
# The API image sets NODE_ENV=production. Mock data is refused in that mode.
# OfficialBMUDataProvider still returns 503 until a real BMU API is contracted.
# Do not point this environment at live student records.

APP_ENV=staging
NODE_ENV=production
BMU_DATA_PROVIDER=official

DATABASE_URL=postgresql://USER:PASSWORD@STAGING_HOST:5432/bmu?schema=public

JWT_ACCESS_SECRET=replace-with-staging-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-staging-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=14

PORT=3000
CORS_ORIGIN=https://staging.example.invalid

OFFICIAL_BMU_API_BASE_URL=
OFFICIAL_BMU_API_KEY=

OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_LOCAL_DIR=
S3_ENDPOINT=https://s3.staging.example.invalid
S3_BUCKET=bmu-student-staging
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

FCM_SERVER_KEY=
FCM_PROJECT_ID=
CRASH_DSN=
