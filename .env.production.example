# Copy into the production secret manager. Never commit the filled file.
# NODE_ENV=production and BMU_DATA_PROVIDER must be exactly official.
# The process exits if mock is selected. The official adapter is not a live
# BMU integration; it fails closed until that integration exists.

APP_ENV=production
NODE_ENV=production
BMU_DATA_PROVIDER=official

DATABASE_URL=postgresql://USER:PASSWORD@PRODUCTION_HOST:5432/bmu?schema=public

JWT_ACCESS_SECRET=replace-with-production-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-production-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=14

PORT=3000
CORS_ORIGIN=https://app.example.invalid

OFFICIAL_BMU_API_BASE_URL=
OFFICIAL_BMU_API_KEY=

OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_LOCAL_DIR=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

FCM_SERVER_KEY=
FCM_PROJECT_ID=
CRASH_DSN=
