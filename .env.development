# Local demo only. Not a production configuration. Do not reuse these secrets.
APP_ENV=development
NODE_ENV=development

DATABASE_URL=postgresql://bmu:bmu@localhost:5432/bmu?schema=public

JWT_ACCESS_SECRET=dev-only-access-secret-not-for-production-use!!
JWT_REFRESH_SECRET=dev-only-refresh-secret-not-for-production-use!!
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=14

PORT=3000
CORS_ORIGIN=http://localhost:3000

# Demo seed data. Refused when NODE_ENV=production.
BMU_DATA_PROVIDER=mock

OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_DIR=.data/objects
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

FCM_SERVER_KEY=
FCM_PROJECT_ID=
CRASH_DSN=
