// BMU Student App — demo schema.
// This database is NOT connected to Baku Engineering University systems.
// All rows are fictional seed data for local development.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ClassStatus {
  SCHEDULED
  CANCELLED
  ROOM_CHANGED
  TIME_CHANGED
  TEACHER_CHANGED
}

enum AssessmentType {
  QUIZ
  ASSIGNMENT
  MIDTERM
  FINAL
  PROJECT
  LAB
  PARTICIPATION
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum SubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  LATE
  GRADED
}

enum MaterialType {
  SLIDE
  DOCUMENT
  LINK
  VIDEO
  OTHER
}

enum AnnouncementAudience {
  UNIVERSITY
  FACULTY
  COURSE
  CLUB
}

enum NotificationType {
  ANNOUNCEMENT
  GRADE
  ASSIGNMENT
  SCHEDULE
  EVENT
  SYSTEM
}

enum AcademicEventType {
  SEMESTER_START
  SEMESTER_END
  REGISTRATION
  EXAM
  ASSESSMENT
  HOLIDAY
  OTHER
}

enum ClubMembershipStatus {
  ACTIVE
  LEFT
}

enum EventRegistrationStatus {
  REGISTERED
  CANCELLED
}

enum SupportCategory {
  ACADEMIC
  TECHNICAL
  CAMPUS
  FINANCIAL
  OTHER
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum BuildingKind {
  ACADEMIC
  LIBRARY
  CAFETERIA
  GYM
  ADMINISTRATION
  DORMITORY
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  firstName    String
  lastName     String
  locale       String   @default("en")
  isActive            Boolean   @default(true)
  /// Optional extra staff classification such as REGISTRAR, LIBRARIAN, or DORM_STAFF.
  /// The Role enum stays STUDENT | TEACHER | ADMIN so existing migrations and JWTs do not change.
  staffRole           String?
  deletionRequestedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt    DateTime @updatedAt

  student            Student?
  teacher            Teacher?
  refreshTokens      RefreshToken[]
  notifications      Notification[]
  supportRequests    SupportRequest[]
  eventRegistrations EventRegistration[]
  clubMemberships          ClubMembership[]
  auditLogs                AuditLog[]
  deviceTokens             DeviceToken[]
  notificationPreference   NotificationPreference?
  storedObjects            StoredObject[]
  supportMessages          SupportMessage[]

  @@index([role])
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Faculty {
  id          String       @id @default(cuid())
  code        String       @unique
  nameEn      String
  nameAz      String
  nameRu      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments   Department[]
  announcements Announcement[]
}

model Department {
  id        String    @id @default(cuid())
  facultyId String
  code      String    @unique
  nameEn    String
  nameAz    String
  nameRu    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  faculty   Faculty   @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  programs      Program[]
  teachers      Teacher[]
  announcements Announcement[]

  @@index([facultyId])
}

model Program {
  id            String     @id @default(cuid())
  departmentId  String
  code          String     @unique
  nameEn        String
  nameAz        String
  nameRu        String
  degreeLevel   String
  durationYears Int
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  groups        Group[]
  students      Student[]

  @@index([departmentId])
}

model Group {
  id        String          @id @default(cuid())
  programId String
  code      String          @unique
  year      Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  program   Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  students       Student[]
  courses        Course[]
  schedules      ClassSchedule[]
  courseOfferings CourseOffering[]

  @@index([programId])
}

model Teacher {
  id             String          @id @default(cuid())
  userId         String          @unique
  departmentId   String
  title          String
  employeeNo     String          @unique
  office         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  department     Department      @relation(fields: [departmentId], references: [id])
  courses         Course[]
  substitutions   ClassSchedule[] @relation("SubstituteTeacher")
  courseOfferings CourseOffering[]

  @@index([departmentId])
}

model Student {
  id             String                @id @default(cuid())
  userId         String                @unique
  programId      String
  groupId        String
  studentNo      String                @unique
  enrollmentYear Int
  photoUrl       String?
  dormRoomId     String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  program        Program               @relation(fields: [programId], references: [id])
  group          Group                 @relation(fields: [groupId], references: [id])
  dormRoom       DormitoryRoom?        @relation(fields: [dormRoomId], references: [id])
  enrollments    Enrollment[]
  grades         Grade[]
  attendance     Attendance[]
  submissions        AssignmentSubmission[]
  studentIdCard      StudentID?
  libraryLoans       LibraryLoan[]
  libraryReservations LibraryReservation[]
  dormApplications   DormApplication[]

  @@index([programId])
  @@index([groupId])
  @@index([dormRoomId])
}

model Building {
  id            String      @id @default(cuid())
  code          String      @unique
  nameEn        String
  nameAz        String
  nameRu        String
  kind          BuildingKind
  latitude      Float?
  longitude     Float?
  descriptionEn String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  classrooms    Classroom[]
  dormitory     Dormitory?

  @@index([kind])
}

model Classroom {
  id             String          @id @default(cuid())
  buildingId     String
  code           String
  name           String
  capacity       Int
  floor          Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  building       Building        @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  schedules      ClassSchedule[] @relation("PrimaryRoom")
  overrideUsages ClassSchedule[] @relation("OverrideRoom")

  @@unique([buildingId, code])
  @@index([code])
}

model Course {
  id            String           @id @default(cuid())
  code          String           @unique
  titleEn       String
  titleAz       String
  titleRu       String
  credits       Int
  semester      String
  teacherId     String
  groupId       String
  descriptionEn String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  teacher       Teacher          @relation(fields: [teacherId], references: [id])
  group         Group            @relation(fields: [groupId], references: [id])
  enrollments   Enrollment[]
  schedules     ClassSchedule[]
  materials     CourseMaterial[]
  assignments   Assignment[]
  assessments   Assessment[]
  announcements   Announcement[]
  attendance      Attendance[]
  offerings       CourseOffering[]
  attendancePolicy AttendancePolicy?

  @@index([teacherId])
  @@index([groupId])
  @@index([semester])
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  courseId  String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

model ClassSchedule {
  id                   String       @id @default(cuid())
  courseId             String
  groupId              String
  classroomId          String
  weekday              Weekday
  startTime            String
  endTime              String
  status               ClassStatus  @default(SCHEDULED)
  note                 String?
  exceptionDate        DateTime?    @db.Date
  exceptionStatus      ClassStatus?
  exceptionNote        String?
  overrideClassroomId  String?
  overrideStartTime    String?
  overrideEndTime      String?
  overrideTeacherId    String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  course               Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  group                Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  classroom            Classroom    @relation("PrimaryRoom", fields: [classroomId], references: [id])
  overrideClassroom    Classroom?   @relation("OverrideRoom", fields: [overrideClassroomId], references: [id])
  overrideTeacher      Teacher?     @relation("SubstituteTeacher", fields: [overrideTeacherId], references: [id])

  @@index([courseId])
  @@index([groupId])
  @@index([weekday])
  @@index([exceptionDate])
}

model Assessment {
  id        String         @id @default(cuid())
  courseId  String
  title     String
  type      AssessmentType
  weight    Int
  maxScore  Float          @default(100)
  date      DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  grades    Grade[]

  @@index([courseId])
}

model Grade {
  id           String     @id @default(cuid())
  studentId    String
  assessmentId String
  score        Float?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([studentId, assessmentId])
  @@index([studentId])
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  courseId  String
  date      DateTime         @db.Date
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, date])
  @@index([studentId, courseId])
}

model Assignment {
  id          String                 @id @default(cuid())
  courseId    String
  title       String
  description String
  deadline    DateTime
  maxScore      Float                  @default(100)
  allowResubmit Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@index([courseId])
  @@index([deadline])
}

model AssignmentSubmission {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  status       SubmissionStatus @default(NOT_SUBMITTED)
  submittedAt  DateTime?
  body         String?
  score        Float?
  objectId     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  object       StoredObject?    @relation(fields: [objectId], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([objectId])
}

model CourseMaterial {
  id        String       @id @default(cuid())
  courseId  String
  title     String
  type      MaterialType
  url       String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  course    Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Announcement {
  id          String               @id @default(cuid())
  title       String
  body        String
  audience    AnnouncementAudience
  courseId     String?
  publishedAt  DateTime             @default(now())
  expiresAt    DateTime?
  facultyId    String?
  departmentId String?
  scheduledFor DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  course       Course?              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty      Faculty?             @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  department   Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([publishedAt])
  @@index([courseId])
  @@index([facultyId])
  @@index([departmentId])
  @@index([expiresAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AcademicEvent {
  id            String            @id @default(cuid())
  titleEn       String
  titleAz       String
  titleRu       String
  type          AcademicEventType
  startsAt      DateTime
  endsAt        DateTime?
  descriptionEn String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([startsAt])
  @@index([type])
}

model Club {
  id            String           @id @default(cuid())
  nameEn        String
  nameAz        String
  nameRu        String
  descriptionEn String
  category      String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  memberships   ClubMembership[]
  events        UniversityEvent[]
}

model ClubMembership {
  id       String               @id @default(cuid())
  clubId   String
  userId   String
  status   ClubMembershipStatus @default(ACTIVE)
  joinedAt DateTime             @default(now())
  leftAt   DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  club     Club                 @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
}

model UniversityEvent {
  id            String              @id @default(cuid())
  clubId        String?
  titleEn       String
  titleAz       String
  titleRu       String
  descriptionEn String
  location      String
  startsAt      DateTime
  endsAt        DateTime
  capacity      Int?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  club          Club?               @relation(fields: [clubId], references: [id], onDelete: SetNull)
  registrations EventRegistration[]

  @@index([startsAt])
  @@index([clubId])
}

model EventRegistration {
  id        String                  @id @default(cuid())
  eventId   String
  userId    String
  status    EventRegistrationStatus @default(REGISTERED)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  event     UniversityEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model LibraryBook {
  id        String   @id @default(cuid())
  isbn      String?  @unique
  title     String
  author    String
  copies    Int
  available Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  loans     LibraryLoan[]
  reservations LibraryReservation[]
}

model Dormitory {
  id         String          @id @default(cuid())
  buildingId String          @unique
  name       String
  gender     String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  building   Building        @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  rooms      DormitoryRoom[]
}

model DormitoryRoom {
  id          String    @id @default(cuid())
  dormitoryId String
  number      String
  capacity    Int
  occupied    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dormitory   Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  residents   Student[]

  @@unique([dormitoryId, number])
}

model SupportRequest {
  id        String          @id @default(cuid())
  userId    String
  category  SupportCategory
  subject   String
  message   String
  status    SupportStatus   @default(OPEN)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  SupportMessage[]

  @@index([userId])
  @@index([status])
}

/// Demo digital ID only. Not an official BMU credential.
model StudentID {
  id         String   @id @default(cuid())
  studentId  String   @unique
  cardNumber String   @unique
  issuedAt   DateTime
  expiresAt  DateTime
  demoOnly   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Release-candidate models. Additive only. Course remains the legacy section
// record (teacherId, groupId, semester string, unique code).
// AttendancePolicy is a configurable app setting, not a university rule.
// StudentServiceInfo is a public directory. It stores no medical records.
// ---------------------------------------------------------------------------

enum SemesterTerm {
  FALL
  SPRING
  SUMMER
}

enum LibraryLoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
}

enum LibraryReservationStatus {
  PENDING
  READY
  CANCELLED
  FULFILLED
  EXPIRED
}

enum DormApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum StudentServiceKind {
  MEDICAL
  PSYCHOLOGICAL
  CAREER
  SPORTS
}

model AcademicYear {
  id        String     @id @default(cuid())
  label     String     @unique
  startsOn  DateTime   @db.Date
  endsOn    DateTime   @db.Date
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  semesters Semester[]
}

model Semester {
  id             String           @id @default(cuid())
  academicYearId String
  term           SemesterTerm
  code           String           @unique
  startsOn       DateTime         @db.Date
  endsOn         DateTime         @db.Date
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  offerings      CourseOffering[]

  @@unique([academicYearId, term])
  @@index([academicYearId])
}

/// Reusable course identity. A catalog row is not a section and has no teacher.
model CourseCatalog {
  id            String           @id @default(cuid())
  code          String           @unique
  titleEn       String
  titleAz       String
  titleRu       String
  credits       Int
  descriptionEn String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  offerings     CourseOffering[]
}

/// One taught section of a catalog course. legacyCourseId points at the
/// existing Course row when this section was seeded from the MVP table.
model CourseOffering {
  id             String        @id @default(cuid())
  semesterId     String
  catalogId      String
  sectionCode    String
  teacherId      String
  groupId        String
  legacyCourseId String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  semester       Semester      @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  catalog        CourseCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  teacher        Teacher       @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  group          Group         @relation(fields: [groupId], references: [id], onDelete: Restrict)
  legacyCourse   Course?       @relation(fields: [legacyCourseId], references: [id], onDelete: SetNull)

  @@unique([semesterId, catalogId, sectionCode])
  @@index([teacherId])
  @@index([groupId])
  @@index([semesterId])
  @@index([catalogId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([resource, resourceId])
  @@index([createdAt])
}

model DeviceToken {
  id        String         @id @default(cuid())
  userId    String
  token     String         @unique
  platform  DevicePlatform
  revokedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  schedule     Boolean  @default(true)
  grade        Boolean  @default(true)
  assignment   Boolean  @default(true)
  announcement Boolean  @default(true)
  event        Boolean  @default(true)
  support      Boolean  @default(true)
  system       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Metadata only. File bytes live in object storage, never in this row.
model StoredObject {
  id          String                 @id @default(cuid())
  ownerId     String?
  purpose     String
  bucket      String
  objectKey   String                 @unique
  mime        String
  size        Int
  checksum    String?
  createdAt   DateTime               @default(now())
  owner       User?                  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  submissions AssignmentSubmission[]

  @@index([ownerId])
  @@index([purpose])
}

model LibraryLoan {
  id        String            @id @default(cuid())
  studentId String
  bookId    String
  status    LibraryLoanStatus @default(ACTIVE)
  dueAt     DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  book      LibraryBook       @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([bookId])
  @@index([status])
}

model LibraryReservation {
  id        String                   @id @default(cuid())
  studentId String
  bookId    String
  status    LibraryReservationStatus @default(PENDING)
  dueAt     DateTime?
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  student   Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  book      LibraryBook              @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([bookId])
}

model DormApplication {
  id        String                @id @default(cuid())
  studentId String
  status    DormApplicationStatus @default(DRAFT)
  note      String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  student   Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
}

model DiningVenue {
  id        String    @id @default(cuid())
  nameEn    String
  nameAz    String
  nameRu    String
  location  String?
  demo      Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  days      MenuDay[]
}

model MenuDay {
  id        String     @id @default(cuid())
  venueId   String
  date      DateTime   @db.Date
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  venue     DiningVenue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  items     MenuItem[]

  @@unique([venueId, date])
  @@index([venueId])
}

model MenuItem {
  id         String   @id @default(cuid())
  menuDayId  String
  nameEn     String
  nameAz     String
  nameRu     String
  priceMinor Int?
  currency   String   @default("AZN")
  demo       Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  menuDay    MenuDay  @relation(fields: [menuDayId], references: [id], onDelete: Cascade)

  @@index([menuDayId])
}

model CareerOpportunity {
  id            String    @id @default(cuid())
  titleEn       String
  titleAz       String
  titleRu       String
  organization  String
  descriptionEn String
  deadline      DateTime?
  demo          Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model CareerEvent {
  id            String    @id @default(cuid())
  titleEn       String
  titleAz       String
  titleRu       String
  location      String
  startsAt      DateTime
  endsAt        DateTime?
  descriptionEn String?
  demo          Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([startsAt])
}

model CareerResource {
  id        String   @id @default(cuid())
  titleEn   String
  titleAz   String
  titleRu   String
  url       String?
  notes     String?
  demo      Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportMessage {
  id        String         @id @default(cuid())
  requestId String
  authorId  String
  body      String
  internal  Boolean        @default(false)
  createdAt DateTime       @default(now())
  request   SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([authorId])
}

/// Configurable attendance threshold for the app. Not an official BMU regulation.
model AttendancePolicy {
  id           String   @id @default(cuid())
  courseId     String?  @unique
  minPercent   Int
  lateCountsAs Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  course       Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model FeatureFlag {
  id        String   @id @default(cuid())
  key       String   @unique
  enabled   Boolean  @default(false)
  audience  String   @default("all")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SyncLog {
  id         String     @id @default(cuid())
  source     String
  status     SyncStatus
  message    String?
  startedAt  DateTime
  finishedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([source, startedAt])
}

/// Campus service directory (hours and location). No diagnoses, notes about
/// a person, or medical records.
model StudentServiceInfo {
  id        String             @id @default(cuid())
  kind      StudentServiceKind
  nameEn    String
  nameAz    String
  nameRu    String
  hours     String
  location  String
  phone     String?
  notes     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([kind])
}
