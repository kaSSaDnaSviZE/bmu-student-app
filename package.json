{
  "name": "bmu-student-app",
  "version": "0.2.0",
  "private": true,
  "description": "BMU Student App — unofficial demo student platform. Not an official Baku Engineering University application.",
  "license": "MIT",
  "workspaces": [
    "apps/api"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm run start:dev -w @bmu/api",
    "start:api": "npm run start:prod -w @bmu/api",
    "build": "npm run build -w @bmu/api",
    "lint": "npm run lint -w @bmu/api",
    "typecheck": "npm run typecheck -w @bmu/api",
    "test": "npm run test -w @bmu/api",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "prisma db seed",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^2.4.3",
    "prisma": "^6.16.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
