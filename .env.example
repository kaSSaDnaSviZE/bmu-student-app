# Copy to .env and change every secret before deploying.
# Never commit .env.

DATABASE_URL=postgresql://bmu:bmu@localhost:5432/bmu?schema=public

# At least 32 random characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters

# Access token lifetime in seconds (15 minutes).
JWT_ACCESS_TTL=900

# Opaque refresh token lifetime in days. Tokens are stored as SHA-256 hashes.
JWT_REFRESH_TTL_DAYS=14

PORT=3000

# Comma-separated browser origins, or * for local development only.
CORS_ORIGIN=http://localhost:3000

# mock = seeded demo data in PostgreSQL
# official = reserved adapter; not connected to BMU
BMU_DATA_PROVIDER=mock

# Used only when BMU_DATA_PROVIDER=official. Leave empty.
# OFFICIAL_BMU_API_BASE_URL=
# OFFICIAL_BMU_API_KEY=
