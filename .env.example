# Copy to .env and change every secret before deploying.
# Never commit .env. Local demo values also live in .env.development.
# Staging and production templates: .env.staging.example and .env.production.example.
# This file has no real secrets.

APP_ENV=development
NODE_ENV=development

DATABASE_URL=postgresql://bmu:bmu@localhost:5432/bmu?schema=public

# At least 32 random characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters

# Optional separate pepper for refresh-token hashing. Unused until wired.
# Generate a distinct value from JWT_ACCESS_SECRET. Leave empty to keep the current hash scheme.
JWT_REFRESH_SECRET=

# Access token lifetime in seconds (15 minutes).
JWT_ACCESS_TTL=900

# Opaque refresh token lifetime in days. Tokens are stored as SHA-256 hashes.
JWT_REFRESH_TTL_DAYS=14

PORT=3000

# Comma-separated browser origins, or * for local development only.
CORS_ORIGIN=http://localhost:3000

# mock = seeded demo data in PostgreSQL
# official = reserved adapter; not connected to BMU
# NODE_ENV=production refuses to start unless this value is exactly official.
# There is no silent fallback to mock in production.
BMU_DATA_PROVIDER=mock

# Used only when BMU_DATA_PROVIDER=official. Leave empty.
# OFFICIAL_BMU_API_BASE_URL=
# OFFICIAL_BMU_API_KEY=

# Object storage. local writes under OBJECT_STORAGE_LOCAL_DIR. s3 does not upload
# until an S3 client is bundled; missing endpoint/bucket/keys throw instead.
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_DIR=.data/objects
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# Push. Both values must be set or the provider stays a no-op and sends nothing.
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# Crash reporting. Empty disables it. Do not put a real DSN in git.
CRASH_DSN=
